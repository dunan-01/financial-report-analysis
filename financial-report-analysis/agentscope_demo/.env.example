MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=financial_demo
MYSQL_PASSWORD=financial_demo_password
MYSQL_DATABASE=financial_demo
MYSQL_CHARSET=utf8mb4

# 企业部署：地址可填写基础路径，或完整的/chat/completions地址。
