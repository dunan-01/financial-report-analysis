# 复制为 .env 后填写企业 OpenAI 兼容模型配置。
# 支持 /v1 基础地址，或以 /chat/completions 结尾的完整地址。
LLM_BASE_URL=http://your-model-server:8000/v1
LLM_MODEL=your-deployed-model
LLM_API_KEY=replace-with-your-api-key
LLM_STREAM=false

# 完全不设置 LLM_* 时，才使用旧 OpenRouter 配置。
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_API_KEY=replace-with-your-api-key
